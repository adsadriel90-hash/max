# Chave da API do MaxPlayer (painel > API). NUNCA coloque isso no HTML.
MAXPLAYER_TOKEN=cole_sua_chave_aqui

# ID do domínio cadastrado no painel MaxPlayer. A URL do servidor é lida desse domínio
# pela API e usada para conferir se o login existe e está ativo.
MAXPLAYER_DOMAIN_ID=1731529261039864009

# Token da API Sigma (painel Sigma > Configurações > Desenvolvedores). NUNCA coloque no HTML.
SIGMA_TOKEN=cole_seu_token_sigma_aqui

# Revendedores autorizados a ativar, separados por vírgula. Pode usar o ID (hashid) da Sigma
# ou o usuário do revendedor. Clientes de outros revendedores são recusados.
SIGMA_REVENDAS_PERMITIDAS=id_ou_usuario_1,id_ou_usuario_2

# Opcional: endereço da API Sigma (padrão: https://sistema.ftspanel.vip/api/integration/v1)
SIGMA_URL=

# Opcional: limite de telas por cliente (vazio = teto padrão da sua conta)
MAX_DEVICES=
